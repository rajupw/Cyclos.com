{
  "name": "cyclos-playwright-automation",
  "version": "1.0.0",
  "description": "Playwright UI/API automation practice suite (Cyclos and other practice sites).",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
